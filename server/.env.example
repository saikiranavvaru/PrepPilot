# SERVER CONFIGURATION
PORT=3000
APP_NAME=PrepPilot API
NODE_ENV=development

# JWT CONFIGURATION
JWT_SECRET=my_long_random_jwt_secret
JWT_EXPIRES_IN=30d

# POSTGRESQL DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_NAME=preppilot
DB_USER=postgres
DB_PASSWORD=my_postgresql_password

# EMAIL CONFIGURATION (optional in local development)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
APP_URL=http://localhost:3000
